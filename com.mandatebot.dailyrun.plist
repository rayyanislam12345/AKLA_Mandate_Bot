<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mandatebot.dailyrun</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/rayyanui/Mandate Bot/run_local_only.sh</string>
    </array>

    <!-- All nine sources, run locally — GitHub Actions is disabled
         (schedule removed, kept as workflow_dispatch only) since two of
         the nine sources are unreachable from its runners. 04:00 PKT. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/rayyanui/Mandate Bot/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rayyanui/Mandate Bot/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
