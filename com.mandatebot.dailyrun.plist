<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mandatebot.dailyrun</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/rayyanui/Mandate Bot/run_local_only.sh</string>
    </array>

    <!-- Punjab + BPPT only — the other 7 sources run on GitHub Actions
         (see .github/workflows/daily-run.yml, 23:00 UTC = 04:00 PKT).
         06:00 PKT gives a 2-hour buffer so this run's `git pull` reliably
         picks up that run's state.json commit first. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/rayyanui/Mandate Bot/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rayyanui/Mandate Bot/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
